{
  "id": "theme_0_blog_ajax",
  "name": "Blog layout với reader ajax",
  "detect": {
    "requiredAll": [],
    "requiredAny": [
      "div.items h1.page-title",
      "figcaption h3 a[href*='/manga/']",
      "div.page-chapter img[src*='data:image/gif']"
    ],
    "excludedAll": [
      "ul.dropdown-menu.megamenu a[href*='/tim-truyen/']"
    ]
  },
  "list": {
    "item": "div.items div.item",
    "title": "figcaption h3 a",
    "linkAttr": "href",
    "thumb": "div.image img",
    "thumbAttr": "data-original|data-src|src",
    "lastChapter": "a[title^=\"Chapter\"]"
  },
  "detail": {
    "root": "article#item-detail",
    "title": "h1.title-detail",
    "cover": "div.col-image img",
    "coverAttr": "src",
    "author": "li.author p.col-xs-8",
    "status": "li.status p.col-xs-8",
    "genres": "li.kind p.col-xs-8 a",
    "description": "div.detail-content p, div.detail-content .shortened",
    "otherName": "h2.other-name"
  },
  "chapters": {
    "item": "div.list-chapter li.row:not(.heading)",
    "link": "a",
    "name": "a",
    "date": "div.col-xs-4"
  },
  "reader": {
    "image": "div.page-chapter > img",
    "imageAttr": "data-original|data-src|src",
    "exclude": ["data:"],
    "title": "h1.txt-primary span",
    "ajax": {
      "enabled": true,
      "url": "/ajax/image/list/chap/{id}",
      "idRegex": "CHAPTER_ID\\s*=\\s*(\\d+)",
      "httpMethod": "POST",
      "headerXRequestedWith": true
    }
  },
  "paging": {
    "mode": "text",
    "selector": ".pagination li.hidden",
    "regex": "Page\\s+(\\d+)\\s*/\\s*(\\d+)"
  },
  "genresNav": "ul.dropdown-menu.megamenu a[href*='/the-loai/']",
  "paths": {
    "home": "/",
    "latest": "/danh-sach-truyen",
    "latestCandidates": ["/tim-truyen"],
    "popular": "/tags/truyen-tranh-hot",
    "advancedSearch": "/tim-kiem-nang-cao",
    "search": "/search",
    "searchParam": "keyword",
    "searchPageMode": "path",
    "searchPagePrefix": "/",
    "pageMode": "path",
    "pagePrefix": "/",
    "pageSuffix": "",
    "genreParam": "genre"
  },
  "statusMap": {
    "đang tiến hành": 1,
    "ongoing": 1,
    "đang ra": 1,
    "đang cập nhật": 1,
    "hoàn thành": 2,
    "full": 2,
    "tạm ngưng": 6,
    "hiatus": 6
  },
  "date": {
    "mode": "relative",
    "unitRegex": "(\\d+)\\s*(giây|phút|giờ|ngày|tuần|tháng|năm)"
  },
  "image": {
    "localhostRefererHosts": ["netcdn.one"],
    "skipCloudflareHosts": ["netcdn.one"]
  },
  "priority": 10
}
