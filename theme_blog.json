{
  "id": "theme_blog",
  "name": "Blog layout",
  "detect": {
    "requiredAll": [],
    "requiredAny": [
      "div.items div.item",
      "article#item-detail div.list-chapter",
      "div.list-chapter li.row"
    ],
    "excludedAll": []
  },
  "list": {
    "item": "div.items div.item",
    "title": "h3 a",
    "linkAttr": "href",
    "thumb": "div.image img, div.item img.image-thumb",
    "thumbAttr": "data-original|data-src|src",
    "lastChapter": "a[title^=\"Chapter\"]"
  },
  "detail": {
    "root": "article#item-detail",
    "title": "h1.title-detail",
    "cover": "div.col-image img",
    "coverAttr": "src",
    "author": "li.author p.col-xs-8",
    "status": "li.status p.col-xs-8",
    "genres": "li.kind p.col-xs-8 a",
    "description": "div.detail-content p, div.detail-content .shortened",
    "otherName": "h2.other-name"
  },
  "chapters": {
    "item": "div.list-chapter li.row:not(.heading)",
    "link": "a",
    "name": "a",
    "date": "div.col-xs-4",
    "json": {
      "url": "/Comic/Services/ComicService.asmx/ChapterList?slug={slug}&comicId={comicId}",
      "root": "data",
      "id": "chapter_num",
      "name": "chapter_name",
      "date": "updated_at",
      "href": "/chuong-{id}",
      "preferFullList": true,
      "comicIdReg": "-([0-9]+)$"
    }
  },
  "reader": {
    "image": "div.page-chapter > img",
    "imageAttr": "data-original|data-src|src",
    "exclude": ["data:"],
    "title": "h1.txt-primary span",
    "ajax": {
      "enabled": false,
      "url": "/ajax/image/list/chap/{id}?cache=0",
      "idRegex": "CHAPTER_ID\\s*=\\s*(\\d+)",
      "httpMethod": "POST",
      "headerXRequestedWith": true
    }
  },
  "paging": {
    "mode": "text",
    "selector": ".pagination li.hidden",
    "regex": "Page\\s+(\\d+)\\s*/\\s*(\\d+)"
  },
  "genresNav": "ul.dropdown-menu.megamenu a[href*='/tim-truyen/']",
  "paths": {
    "home": "/trang-chu",
    "latest": "/danh-sach-truyen",
    "latestCandidates": ["/truyen-tranh-moi", "/tim-truyen"],
    "popular": "/truyen-tranh-hot",
    "advancedSearch": "/tim-kiem-nang-cao",
    "search": "/tim-truyen",
    "searchParam": "keyword",
    "pageMode": "param",
    "pagePrefix": "/",
    "pageSuffix": "",
    "genreParam": "genres"
  },
  "statusMap": {
    "đang tiến hành": 1,
    "ongoing": 1,
    "đang ra": 1,
    "đang cập nhật": 1,
    "hoàn thành": 2,
    "full": 2,
    "tạm ngưng": 6,
    "hiatus": 6
  },
  "date": {
    "mode": "relative",
    "unitRegex": "(\\d+)\\s*(giây|phút|giờ|ngày|tuần|tháng|năm)"
  },
  "image": {
    "localhostRefererHosts": ["netcdn.one"],
    "skipCloudflareHosts": ["netcdn.one"]
  },
  "priority": 5
}
